# ─────────────────────────────────────────────────────────────────────────────
# 「部署在测试服务器上」的 profile 模板 —— 用 `APP_ENV=testsrv` 激活。
#   cp .env.testsrv.example .env.testsrv   # .env.testsrv 已 gitignore，真值不进仓库
#
# 与 .env.test 的区别：.env.test 是【本机开发、连测试服平台】；
#                     .env.testsrv 是【应用本身就跑在测试服 13.229.50.42 上】。
# 对外入口：https://testtapi2.broly.ai/social/  （复用现有域名 + 路径前缀，无需加 DNS 子域）
# ─────────────────────────────────────────────────────────────────────────────

# ── 路径前缀部署 ──
# 该机 nginx(tw.ai.conf) 的既定套路：同域名按路径前缀分流（/ai-api/→8079、/user-api/→8089…）。
# 我们沿用：/social/ → 前端 13001。Next 的 basePath 与 api.ts 的 fetch 基址都读这个值。
NEXT_PUBLIC_BASE_PATH=/social
# 媒体 URL 前缀：后端返 ${PUBLIC_BASE_URL}/media/<key>，须与 basePath 一致，
# 否则图片 <img src="/media/..."> 会打到站点根、绕过 /social 前缀 → 404。
PUBLIC_BASE_URL=/social

# ── 端口（务必避开该机既有：3000/3002/8000/8079/8083/8084/8085/8089/8888/8889/9999/5433…）──
PORT=18091
# 前端 next start 的端口在 systemd 单元里指定（13001）。
# Next 服务端 rewrite 的后端地址：同机直连。
SSA_BACKEND_URL=http://127.0.0.1:18091

# ── 平台地址：同机【内网直连】，不再绕公网域名 ──
# ai-api 容器映射 0.0.0.0:8079->8070，chatpal 映射 0.0.0.0:8089->8080。
# 直连的好处：少一跳 nginx/公网、更快更稳，且不受公网安全组影响。
AI_API_BASE_URL=http://127.0.0.1:8079
CHATPAL_BASE_URL=http://127.0.0.1:8089

# ── 鉴权 ──
# ⚠️ 关旁路：只认平台 JWT（配合 auth.ts 的 P0 修复，x-user-id 一并失效）。
DEV_FAKE_USER_ID=
NEXT_PUBLIC_REQUIRE_LOGIN=true
NEXT_PUBLIC_DEV_USER_ID=
# ⚠️ JWT_SECRET 见下方「待确认」——ai-api 与 chatpal 的密钥现已不一致，这里先继承 .env 的回落串
# （chatpal 认它 → 登录/验签能用）；ai-api 那边等真值。

# ── 计费 ──
# ai-api 密钥未对齐前，real 会让每次生成都 502。密钥到位后改回 real。
BILLING_MODE=stub

# ── 数据库：本机独立 MySQL 容器（social-agent-mysql，13307，专属网络+专属卷）──
# 刻意【不】复用该机现有的 postgres/redis/yanfa 库：隔离，坏了也炸不到别人。
DB_HOST=127.0.0.1
DB_PORT=13307
DB_USER=social_agent
DB_NAME=social_agent
# DB_PASSWORD 在真值文件 .env.testsrv 里填，不进仓库。
DB_PASSWORD=
DB_POOL_SIZE=10

# ── 生成（模型网关，与本地相同）──
GENERATION_MODE=llm
GLBGPT_MODEL_BASE_URL=https://api.basi.monster/v1
# GLBGPT_MODEL_API_KEY 在真值文件里填。
GLBGPT_MODEL_API_KEY=
GENERATION_TEXT_MODEL=gpt-5-chat
GENERATION_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ── 媒体 ──
MEDIA_STORAGE=local

# ─────────────────────────────────────────────────────────────────────────────
# 生产环境 profile 模板 —— 复制为 .env.prod 填真值，用 `APP_ENV=prod pnpm build && APP_ENV=prod pnpm start` 激活。
#   cp .env.prod.example .env.prod   # .env.prod 已被 gitignore，真值绝不进仓库
#
# 只写与共享默认 .env 【不同】的项；其余自动继承 .env。
# 优先级：shell 环境变量 > .env.prod > .env
#   → 真正的生产密钥建议走【 shell / systemd EnvironmentFile / 密钥管理】注入，压过文件值，
#     文件里只留结构，落盘的明文越少越好。
#
# 本文件是「上生产必须改什么」的清单。每一项都要人工确认，不要照抄测试值。
# ─────────────────────────────────────────────────────────────────────────────

# ── 鉴权（安全关键，两项必须同时正确）──
# 1) 生产 JWT 密钥：找运维要真实注入值。
#    ⚠️ 绝不能用 .env 里那个测试串（那是测试服 ai-newtest.yml 的默认回落值，已在多处出现，等同公开）。
#    密钥错 = 所有平台 token 验签失败 = 全站 401；密钥用了测试值 = 任何人可自签 token 冒充任意用户。
JWT_SECRET=
# 2) 旁路必须留空（= 彻底关闭 x-user-id 与假 userId，见 apps/server/src/auth.ts P0 修复注释）。
#    这一行留空是【安全底线】，任何情况下都不要在生产填值。
DEV_FAKE_USER_ID=

# ── 前端 ──
# 生产必须开登录门禁（否则前端会用兜底 x-user-id，而后端已关旁路 → 满屏 401）。
NEXT_PUBLIC_REQUIRE_LOGIN=true
NEXT_PUBLIC_DEV_USER_ID=

# ── 平台地址（换成生产 chatpal / ai-api，不要指着 testtapi2）──
CHATPAL_BASE_URL=
AI_API_BASE_URL=

# ── 计费 ──
# 生产真扣。扣的是用户真金白银，上线前请先确认 TEXT_BILLING_MODEL 在生产 robot 表有价（否则扣不到=白送）。
BILLING_MODE=real
BILLING_PRODUCT_NO=glbgpt
TEXT_BILLING_MODEL=gpt-5.4

# ── 数据库（生产 MySQL；账号最小权限，别复用 dev 的 social_agent/dev_pw）──
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=social_agent
DB_POOL_SIZE=20

# ── 对外入口（正规域名 + 证书；X 后台登记的回调必须与 X_REDIRECT_URI 一字不差）──
APP_PUBLIC_URL=https://
X_REDIRECT_URI=https:///api/connections/x/callback
# 生产 X 应用凭证（别复用 demo/x-poster 那套测试账号的）
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── 媒体存储 ──
# 生产不要用 local FS（多实例不共享、重启即丢），换 S3 兼容。
MEDIA_STORAGE=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

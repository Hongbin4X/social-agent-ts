# ── 数据库连接（@social/db 从这里读；本地默认指向 docker-compose.dev.yml 的 dev MySQL）──
# 联调/上线：把下面几项改成远端 yanfa MySQL 的地址与凭证即可，代码零改动。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=social_agent
DB_PASSWORD=dev_pw
DB_NAME=social_agent
# 连接池
DB_POOL_SIZE=10

# ── 后端服务 ──
PORT=8091

# ── 鉴权 ──
# 平台共享 JWT 密钥（chatpal/ai-api 同一把，原始 UTF-8 字节、不 base64）。配了才验签 Bearer；见飞书子文档① A0。
# 测试环境值 = ai-newtest.yml 里 jwt.secret 的默认回落串；生产另找运维要真实注入值。
JWT_SECRET=
# 本地开发旁路：无平台 JWT 时用这个假 userId 直接通过（带 Bearer 时以验签为准）。
# ⚠️ 本项同时是【整个旁路的总开关】：留空 = 连 x-user-id 头也一并失效、只认 JWT（生产/联调必须留空，与验签同批）。
DEV_FAKE_USER_ID=1000000000000000001
# chatpal 根地址（后端登录代理用，如 http://<测试服内网>:8089）。后端自拼 /user-api/user/{sendEmailVerifyCode,emailLogin}。
# 留空 = 登录路由如实 501「未接通」。前端 /bff/auth/* 反代到本后端，由后端代调 chatpal（chatpal 不对前端直接暴露）。
CHATPAL_BASE_URL=
# 平台渠道标识（emailLogin/sendEmailVerifyCode 的 channel 字段）。默认 chatpal。
PLATFORM_CHANNEL=chatpal

# ── 内容生成（生成模型接入；未配置时生成层如实报未接通/走确定性桩）──
# GLBGPT 模型层网关（联调时填）。留空 = 用 deterministic 桩 adapter，能跑通全链路但不产真内容。
GENERATION_MODE=stub
GLBGPT_MODEL_BASE_URL=
GLBGPT_MODEL_API_KEY=
# 生成模型（≠计费档 TEXT_BILLING_MODEL）。⚠️ gpt-5.3-chat 及高版本 chat 上游常 429 饱和；
# 实测稳定：gpt-5-chat / gpt-5.4-mini / gpt-5-mini / gemini-3-flash-preview。
GENERATION_TEXT_MODEL=
GENERATION_IMAGE_MODEL=

# ── 计费（stub=本地账本不真扣 / real=接 ai-api 真扣，见飞书子文档②改造清单 #6）──
BILLING_MODE=stub
# real 模式必需：ai-api 根地址（测试服内网，如 http://<ip>:8070）。适配器自拼 /ai-api/ai/bill/*。
AI_API_BASE_URL=
# 账单归属 productNo（本项目复用 glbgpt，无需平台加枚举）。
BILLING_PRODUCT_NO=glbgpt
# 文本「计费档」——recordBill 上报此 model，必须在 robot 表有 tokens 价（如 gpt-5.4）。
# ⚠️ 与生成模型 GENERATION_TEXT_MODEL(gpt-5.3-chat) 故意解耦：网关真实模型与 robot 计费档名字不重合。
TEXT_BILLING_MODEL=gpt-5.4

# ── 媒体对象存储（图片/将来视频；DB 只存引用）──
# local = 本地 FS（dev 默认，落盘 apps/server/.media，经 ${PUBLIC_BASE_URL}/media 访问）；s3 = S3 兼容（留桩）
MEDIA_STORAGE=local
PUBLIC_BASE_URL=http://localhost:8091
MEDIA_LOCAL_DIR=
# S3 兼容（联调/上线再填；AWS S3 / 阿里云 OSS / R2 / MinIO 通用）
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── 发布（沿用 @social/publisher）──
SOCIAL_PUBLISH_MODE=direct

# ── X(Twitter) 真实账号授权 + 发帖（direct 模式）──
# 在 X 开发者后台建 Project+App，User authentication settings 选 Read and write + Web App，
# 拿 OAuth2 Client ID/Secret，回调地址填 X_REDIRECT_URI 并在后台登记（须一字不差）。
# Client Secret 只在后端、绝不进前端/代码仓库。未配 X_CLIENT_ID 时授权路由如实报 501「未接通」。
X_CLIENT_ID=
X_CLIENT_SECRET=
# 真回调重定向地址：X 授权后把用户浏览器直接重定向到这里（GET /api/connections/x/callback）。
# 必须与 X 开发者后台登记的 Callback URI【一字不差】，且公网可达 + 正规 HTTPS。
# 生产走固定子域名（见 deploy/nginx/social-agent.conf，nginx 反代到 server:8091）。
X_REDIRECT_URI=https://x.broly.ai/api/connections/x/callback
# 留空=用默认 scope：tweet.read tweet.write users.read media.write offline.access（offline.access 必带，换 refresh token）
X_OAUTH_SCOPES=

# 应用对外公网入口（前端+后端同域）。X 回调成功页据此 postMessage 回前端刷新账号；本地留空则 postMessage 到 "*"。
APP_PUBLIC_URL=https://x.broly.ai

# ── 前端（apps/web，NEXT_PUBLIC_* 为构建期注入的公开变量）──
# 登录门禁：true = 无平台 token 时先过 chatpal 邮箱验证码登录换 JWT；留空/false = 本地开发直接进主界面（x-user-id 兜底，行为不变）。
NEXT_PUBLIC_REQUIRE_LOGIN=
# 本地开发身份：前端无 token 时兜底发的 x-user-id，须与后端 DEV_FAKE_USER_ID 一致。
NEXT_PUBLIC_DEV_USER_ID=1000000000000000001
